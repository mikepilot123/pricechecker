{
  "manifest_version": 3,
  "name": "JQ Electronics — Repair Hub",
  "short_name": "Repair Hub",
  "description": "Quick access to repair prices, check-ins, and inventory from the toolbar — opens the shop's Repair Hub in a side panel.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Repair Hub"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
