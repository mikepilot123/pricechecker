# Copy to .env and fill in locally. Never commit real secrets.

# Neon (or any Postgres URL the serverless driver accepts)
DATABASE_URL=

# Shop PIN for the existing web app — not used as the ChatGPT connector secret
INTAKE_PIN=

# Required for ChatGPT/MCP. Send as: Authorization: Bearer <token>
MCP_AUTH_TOKEN=

# Optional local MCP listen port (default 8787)
MCP_PORT=8787

# Local inspector only. Never enable this on a public URL.
# MCP_ALLOW_UNAUTHENTICATED=1
